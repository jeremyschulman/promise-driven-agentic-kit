# Copy to .env and fill in — or just `export` these. Auth is a Google
# SERVICE-ACCOUNT JSON (Application Default Credentials), not an API key.

# Required: absolute path to the service-account JSON (Vertex AI User role).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: derived from the credentials file's project_id if unset.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Vertex region. Defaults to "global".
# GOOGLE_CLOUD_LOCATION=global

# Optional: model id. Defaults to gemini-3.5-flash.
# GRAIL_AGENT_MODEL=gemini-3.5-flash

# Set automatically to True by grail.env; shown here for clarity.
# GOOGLE_GENAI_USE_VERTEXAI=True
