[0.050, "o", "\r\u001b[2K\u001b[32m⠙\u001b[0m \u001b[2mthe Marshal considers…\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[0.000, "o", "\u001b[1;32mmarshal\u001b[0m\r\n"]
[0.003, "o", "Welcome, Sir Lancelot! Your identity as a Knight of the Round Table is verified,\r\nand your quest is recorded.                                                     \r\n\r\nAs Marshal of the Trials, I stand ready to guide you. To earn the right to seek \r\nthe Holy Grail, you must face and pass two perilous trials:                     \r\n\r\n\u001b[36m 1 \u001b[0m\u001b[1mThe Bridge of Death\u001b[0m (guarded by the Bridgekeeper, where you must answer three\r\n\u001b[36m   \u001b[0mquestions)                                                                   \r\n\u001b[36m 2 \u001b[0m\u001b[1mThe Knights Who Say Ni\u001b[0m (who demand a shrubbery)                              \r\n\r\nYou may attempt either trial first, or ask me for your progress at any time.    \r\nWhich trial do you wish to face first, brave knight?                            \r\n\r\n"]
[1.202, "o", "\u001b[1;36mseeker\u001b[0m: I shall brave the Bridge of Death. My name is Sir Lancelot, my quest is \r\nto seek the Holy Grail, and my favourite colour is\u001b[33m...\u001b[0m green.\r\n"]
[0.000, "o", "\u001b[?25l"]
