[0.017, "o", "\r\u001b[2K\u001b[32m⠏\u001b[0m \u001b[2mthe Marshal considers…\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[0.000, "o", "\u001b[1;32mmarshal\u001b[0m\r\n"]
[0.001, "o", "Ni! Ni! That shrubbery will not do — \u001b[1mit is too expensive\u001b[0m for your budget of 50  \r\ngroats (price: 90 groats).                                                      \r\n\r\nBring us another! Perhaps one that looks nice, but is not so dear.              \r\n\r\n"]
[1.209, "o", "\u001b[1;36mseeker\u001b[0m: Then I offer the lovely laurel instead.\r\n\u001b[?25l"]
