[0.002, "o", "\r\u001b[2K\u001b[32m⠼\u001b[0m \u001b[2mthe Marshal considers…\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[0.000, "o", "\u001b[1;32mmarshal\u001b[0m\r\n"]
[0.001, "o", "A fine shrubbery, and not too dear! It is both nice enough to please us and well\r\nwithin your budget.                                                             \r\n\r\nYou have appeased the Knights Who Say Ni. You may pass, knight!                 \r\n\r\nYou have successfully passed both trials! What say you now, Sir Lancelot?       \r\n\r\n"]
[1.203, "o", "\u001b[1;36mseeker\u001b[0m: Both trials are behind me — may I now seek the Holy Grail?\r\n"]
[0.000, "o", "\u001b[?25l"]
