[0.078, "o", "\r\u001b[2K\u001b[32m⠙\u001b[0m \u001b[2mthe Marshal considers…\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[0.000, "o", "\u001b[1;32mmarshal\u001b[0m\r\n"]
[0.003, "o", "We are the Knights Who Say... \u001b[1mNi!\u001b[0m                                               \r\n\r\nTo pass through our sacred woods, you must find us a shrubbery! One that looks  \r\nnice (with a niceness score of at least \u001b[1m5\u001b[0m), and one that is not too expensive   \r\n(well within your budget of \u001b[1m50 gold\u001b[0m).                                           \r\n\r\nRoger the Shrubber currently has the following shrubberies on offer:            \r\n\r\n\u001b[36m 1 \u001b[0m\u001b[1m\"a modest sprig\"\u001b[0m (ID: \u001b[1;36;40mSH1\u001b[0m)                                                   \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mNiceness:\u001b[0m 2                                                               \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mPrice:\u001b[0m 10 gold                                                            \r\n\u001b[36m 2 \u001b[0m\u001b[1m\"a lovely laurel\"\u001b[0m (ID: \u001b[1;36;40mSH2\u001b[0m)                                                  \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mNiceness:\u001b[0m 8                                                               \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mPr"]
[0.000, "o", "ice:\u001b[0m 40 gold                                                            \r\n\u001b[36m 3 \u001b[0m\u001b[1m\"an ornate topiary\"\u001b[0m (ID: \u001b[1;36;40mSH3\u001b[0m)                                                \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mNiceness:\u001b[0m 9                                                               \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mPrice:\u001b[0m 90 gold                                                            \r\n\u001b[36m 4 \u001b[0m\u001b[1m\"a sad little twig\"\u001b[0m (ID: \u001b[1;36;40mSH4\u001b[0m)                                                \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mNiceness:\u001b[0m 1                                                               \r\n\u001b[36m   \u001b[0m\u001b[1m • \u001b[0m\u001b[1mPrice:\u001b[0m 5 gold                                                             \r\n\r\nWhich of these shrubberies would you like to present to us? Choose wisely, or we\r\nshall say \u001b[1mNi!\u001b[0m to you again!                                                     \r\n"]
[0.000, "o", "\r\n"]
[1.203, "o", "\u001b[1;36mseeker\u001b[0m: I present the ornate topiary.\r\n"]
