# Copy to .env and fill in — or just `export` these in your shell.
# Auth is a Google SERVICE-ACCOUNT JSON (Application Default Credentials), not an API key.

# Required: absolute path to the service-account JSON (Vertex AI User role).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: derived from the credentials file's project_id if left unset.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Vertex region. Defaults to "global" (current Gemini models are served there).
# GOOGLE_CLOUD_LOCATION=global

# Optional: model id. Defaults to gemini-3.5-flash.
# CLINIC_AGENT_MODEL=gemini-3.5-flash

# Set automatically to True by clinic.env; shown here for clarity.
# GOOGLE_GENAI_USE_VERTEXAI=True
