<?xml version="1.0" encoding="UTF-8"?>
<!--
  promise-common.xsd
  ==================================================================
  Shared building blocks for the two contract-document families:

    - agent-contract.xsd   validates  agent_*.xml    (LLM agents:
                           FizzBee behavior model + promise manifest + prose)
    - agent-manifest.xsd   validates  manifest_*.xml (non-LLM agents:
                           promise manifest only, no FizzBee)

  Both families share the SAME Promise Theory vocabulary — an agent
  publishes OFFERS (+) it makes to named parties under stated
  CONDITIONS, and declares the USES (-) it accepts from other agents.
  That vocabulary lives here so the two schemas cannot drift apart.

  Design decisions (see the sibling schemas' headers for the rest):
    * No target namespace. These documents are authored without an
      xmlns, so the schemas are "no-namespace" and are pulled in with
      <xs:include> (chameleon inclusion), not <xs:import>. This keeps
      the whole set copy-paste portable into another project.
    * Prescriptive, not merely descriptive: the promise `type`
      vocabulary and the fizzbee `mode` are enumerated so a typo is a
      validation error, not a silent semantic drift. Extend the
      enumerations deliberately when your system needs a new category.
  ==================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ============================================================
       Simple types: the controlled vocabularies
       ============================================================ -->

  <xs:annotation>
    <xs:documentation>
      A dotted version string, e.g. "1.0". Used for the `version`
      attribute on both document roots.
    </xs:documentation>
  </xs:annotation>
  <xs:simpleType name="VersionString">
    <xs:restriction base="xs:token">
      <xs:pattern value="[0-9]+(\.[0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PromiseType">
    <xs:annotation>
      <xs:documentation>
        The kind of promise an &lt;offer&gt; represents. This is a
        controlled vocabulary on purpose — every offer must declare
        which category it belongs to, and an unrecognised value fails
        validation. The categories are intentionally generic (they are
        Promise Theory roles, not expense-domain nouns), so they carry
        over to any agent system built with this technique:

          workflow      A multi-step capability the agent performs on
                        request (the thing a user asks it to do).
          invariant     A published safety outcome intended to hold regardless
                        of input (e.g. "never submits a report").
                        Typically backed by code enforcement.
          session-state Shared, persisted state the agent publishes for
                        other agents to read (blackboard-as-agent).
          auth          An authenticated session / credential the agent
                        vends to consumers.
          identity      A verified principal (who the request is from).
          receipts      Staged binary artifacts (files) made available
                        to downstream agents.
          ocr           A best-effort extraction/interpretation result
                        (explicitly non-authoritative).
          ux            A user-facing surface: progress frames, a final
                        reply, rendered output.
          card          Exterior catalog/advertising text (what the
                        outside world sees on the agent card).

        Add a value here only when a genuinely new category appears;
        prefer reusing an existing one.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="workflow"/>
      <xs:enumeration value="invariant"/>
      <xs:enumeration value="session-state"/>
      <xs:enumeration value="auth"/>
      <xs:enumeration value="identity"/>
      <xs:enumeration value="receipts"/>
      <xs:enumeration value="ocr"/>
      <xs:enumeration value="ux"/>
      <xs:enumeration value="card"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AssessedBy">
    <xs:annotation>
      <xs:documentation>
        How a condition is assessed. The only recognised value is
        "self": the PROMISEE self-assesses the condition (it is not
        quenched by another agent's offer in the promise graph). Omit
        the attribute for the default — the condition is expected to be
        quenched by a matching `use ... quenches="..."` elsewhere in
        the graph, which scripts/verify_promise_graph.py checks.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="self"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================
       Promise Theory elements: offer / use / condition / tool
       ============================================================ -->

  <xs:complexType name="PromiseCondition">
    <xs:annotation>
      <xs:documentation>
        A precondition on an offer. `ref` names a state predicate —
        by convention the same name as a FizzBee guard variable in the
        &lt;verifiable-behavior&gt; section (e.g. patient_verified), so the
        prose promise and the model-checked spec use one vocabulary.
        A condition is either quenched by some agent's
        `use ... quenches="ref"` or self-assessed (assessed="self").
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="ref" type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="assessed" type="AssessedBy" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PromiseOffer">
    <xs:annotation>
      <xs:documentation>
        A promise this agent makes (+). `to` is a space-separated list
        of the parties the promise is made to (agents or external
        actors such as "user" or "patient", and named services). The
        &lt;body&gt; is the human-readable promise text; for card-type
        offers the body IS the published string (byte-significant).
        `entailed-by` (used on the superagent's exterior offers) names
        the interior offer ids that justify this derived promise;
        the promise-graph verifier fails if any referenced id is
        missing.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="body" type="xs:string"/>
      <xs:element name="condition" type="PromiseCondition"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="type" type="PromiseType" use="required"/>
    <xs:attribute name="to" type="xs:NMTOKENS" use="required"/>
    <xs:attribute name="entailed-by" type="xs:NMTOKENS" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PromiseUse">
    <xs:annotation>
      <xs:documentation>
        A promise this agent accepts to use (-) from another agent.
        `from` names the single providing agent. `quenches` is a
        space-separated list of condition refs that consuming this
        offer satisfies — this is the edge the promise-graph verifier
        follows from a consumer's need to a provider's offer.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="body" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="from" type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="quenches" type="xs:NMTOKENS" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ToolRef">
    <xs:annotation>
      <xs:documentation>
        A tool this agent is bound to. `name` must resolve to a real
        callable in the tool module at construction time
        (toolbinding.manifest_construction raises if it does not).
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required"/>
  </xs:complexType>

</xs:schema>
